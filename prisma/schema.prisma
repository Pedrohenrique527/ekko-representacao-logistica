generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { ADMIN USER MANAGER VIEWER }
enum ImportStatus { PROCESSING VALIDATED COMPLETED FAILED }

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  passwordHash String
  role        UserRole     @default(USER)
  imports     ImportBatch[]
  auditLogs   AuditLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ImportBatch {
  id             String       @id @default(cuid())
  fileName       String
  fileHash       String       @unique
  status         ImportStatus @default(PROCESSING)
  sheetsUsed     String[]
  rowsFound      Int
  rowsInserted   Int
  totalExcel     Decimal      @db.Decimal(18, 2)
  totalDatabase  Decimal      @db.Decimal(18, 2)
  integrityScore Decimal      @db.Decimal(5, 2)
  durationMs     Int
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  orders         Order[]
  issues         ValidationIssue[]
  createdAt      DateTime     @default(now())

  @@index([createdAt])
  @@index([status])
}

model Order {
  id               String      @id @default(cuid())
  externalOrder     String
  client            String?
  supplier          String
  representative    String?
  carrier           String?
  invoice           String?
  mirrorNumber      String?
  value              Decimal     @db.Decimal(18, 2)
  freight            Decimal?    @db.Decimal(18, 2)
  sentAt             DateTime?
  expectedAt         DateTime?
  dueAt              DateTime?
  deliveredAt        DateTime?
  deadlineStatus     String?
  deliveryStatus     String?
  observations       String?
  sourceSheet        String
  sourceRow          Int
  importBatchId      String
  importBatch        ImportBatch @relation(fields: [importBatchId], references: [id])
  createdAt          DateTime     @default(now())

  @@unique([importBatchId, sourceSheet, sourceRow])
  @@index([externalOrder])
  @@index([supplier])
  @@index([deadlineStatus])
  @@index([deliveredAt])
}

model ValidationIssue {
  id            String      @id @default(cuid())
  type          String
  severity      String
  sourceSheet   String
  sourceRow     Int?
  externalOrder String?
  field         String?
  message       String
  excelValue    String?
  databaseValue String?
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([importBatchId, type])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, action])
}
